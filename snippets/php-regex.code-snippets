    "PHP Validate Credit Card": {
        "prefix": "!php-credit-card",
        "body": "<?php\nfunction validateCreditCard($cardNumber) {\n    // Remove spaces and dashes\n    $cardNumber = preg_replace('/[\\s-]/', '', $cardNumber);\n    \n    // Check if it's all digits and correct length\n    if (!preg_match('/^\\d{13,19}$/', $cardNumber)) {\n        return false;\n    }\n    \n    // Luhn algorithm\n    $sum = 0;\n    $alternate = false;\n    \n    for ($i = strlen($cardNumber) - 1; $i >= 0; $i--) {\n        $digit = intval($cardNumber[$i]);\n        \n        if ($alternate) {\n            $digit *= 2;\n            if ($digit > 9) {\n                $digit = ($digit % 10) + 1;\n            }\n        }\n        \n        $sum += $digit;\n        $alternate = !$alternate;\n    }\n    \n    return ($sum % 10 === 0);\n}\n\n$card = '${1:4532-1234-5678-9012}';\n\nif (validateCreditCard($card)) {\n    echo \"Valid credit card\";\n} else {\n    echo \"Invalid credit card\";\n}\n?>",
        "description": "Validate credit card number with Luhn algorithm"
    }
