    "Java Clean Text": {
        "prefix": "!java-clean-text",
        "body": "import java.util.regex.Pattern;\n\npublic class TextCleaner {\n    public static String cleanText(String text) {\n        // Remove special characters except letters, numbers, and spaces\n        String cleaned = text.replaceAll(\"[^a-zA-Z0-9\\\\s]\", \"\");\n        \n        // Replace multiple spaces with single space\n        cleaned = cleaned.replaceAll(\"\\\\s+\", \" \");\n        \n        // Trim whitespace\n        return cleaned.trim();\n    }\n    \n    public static void main(String[] args) {\n        String text = \"${1:Your text with @#$ special chars!!!}\";\n        String cleaned = cleanText(text);\n        \n        System.out.println(\"Original: \" + text);\n        System.out.println(\"Cleaned: \" + cleaned);\n    }\n}",
        "description": "Clean text by removing special characters"
    },
    "Java Date Validation": {
        "prefix": "!java-date",
        "body": "import java.util.regex.Pattern;\nimport java.time.LocalDate;\nimport java.time.format.DateTimeFormatter;\nimport java.time.format.DateTimeParseException;\n\npublic class DateValidator {\n    private static final String DATE_PATTERN_YYYY_MM_DD = \"^\\\\d{4}-\\\\d{2}-\\\\d{2}$\";\n    private static final String DATE_PATTERN_DD_MM_YYYY = \"^\\\\d{2}/\\\\d{2}/\\\\d{4}$\";\n    \n    private static final Pattern patternYMD = Pattern.compile(DATE_PATTERN_YYYY_MM_DD);\n    private static final Pattern patternDMY = Pattern.compile(DATE_PATTERN_DD_MM_YYYY);\n    \n    public static boolean isValidFormat(String date, String format) {\n        try {\n            DateTimeFormatter formatter = DateTimeFormatter.ofPattern(format);\n            LocalDate.parse(date, formatter);\n            return true;\n        } catch (DateTimeParseException e) {\n            return false;\n        }\n    }\n    \n    public static void main(String[] args) {\n        String date = \"${1:2023-12-25}\";\n        String format = \"${2:yyyy-MM-dd}\";\n        \n        if (isValidFormat(date, format)) {\n            System.out.println(\"Valid date format\");\n        } else {\n            System.out.println(\"Invalid date format\");\n        }\n    }\n}",
        "description": "Java date format validation"
    },
