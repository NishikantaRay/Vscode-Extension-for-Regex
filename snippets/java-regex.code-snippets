    "Java Extract URLs": {
        "prefix": "!java-extract-urls",
        "body": "import java.util.regex.Pattern;\nimport java.util.regex.Matcher;\nimport java.util.List;\nimport java.util.ArrayList;\n\npublic class URLExtractor {\n    private static final String URL_PATTERN = \n        \"https?://[^\\\\s$.?#].[^\\\\s]*\";\n    \n    private static final Pattern pattern = Pattern.compile(URL_PATTERN, Pattern.CASE_INSENSITIVE);\n    \n    public static List<String> extractUrls(String text) {\n        List<String> urls = new ArrayList<>();\n        Matcher matcher = pattern.matcher(text);\n        \n        while (matcher.find()) {\n            urls.add(matcher.group());\n        }\n        \n        return urls;\n    }\n    \n    public static void main(String[] args) {\n        String text = \"${1:Visit https://example.com and http://google.com}\";\n        \n        List<String> urls = extractUrls(text);\n        \n        System.out.println(\"Found URLs:\");\n        for (String url : urls) {\n            System.out.println(url);\n        }\n    }\n}",
        "description": "Extract all URLs from text"
    },
    "Java Phone Number Validation": {
        "prefix": "!java-phone",
        "body": "import java.util.regex.Pattern;\n\npublic class PhoneValidator {\n    // US phone number patterns\n    private static final String PHONE_PATTERN = \n        \"^\\\\+?1?[2-9]\\\\d{2}[2-9]\\\\d{2}\\\\d{4}$\";\n    \n    private static final Pattern pattern = Pattern.compile(PHONE_PATTERN);\n    \n    public static boolean isValid(String phone) {\n        // Remove all non-digit characters\n        String cleanedPhone = phone.replaceAll(\"[^\\\\d]\", \"\");\n        return pattern.matcher(cleanedPhone).matches();\n    }\n    \n    public static void main(String[] args) {\n        String phone = \"${1:(555) 123-4567}\";\n        \n        if (isValid(phone)) {\n            System.out.println(\"Valid phone number\");\n        } else {\n            System.out.println(\"Invalid phone number\");\n        }\n    }\n}",
        "description": "Java phone number validation"
    },
